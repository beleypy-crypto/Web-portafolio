---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const options = [
  { code: 'es', label: 'ES', href: '/es/' },
  { code: 'en', label: 'EN', href: '/en/' },
];
---

<div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 p-1 text-xs font-semibold">
  {options.map((option) => (
    <a
      href={option.href}
      aria-current={lang === option.code ? 'page' : undefined}
      class:list={[
        'rounded-full px-3 py-1 transition',
        lang === option.code ? 'bg-cyan-400 text-slate-950' : 'text-slate-300 hover:text-white',
      ]}
    >
      {option.label}
    </a>
  ))}
</div>
