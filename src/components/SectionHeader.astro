---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">
  <p class="pill inline-flex rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.22em]">
    {eyebrow}
  </p>
  <h2 class="mt-5 text-3xl font-black text-white sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base leading-8 text-slate-300">{subtitle}</p>}
</div>
