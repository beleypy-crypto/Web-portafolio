---
import type { Dictionary } from '../i18n/es';
import { site } from '../data/site';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t.contact.defaultMessage)}`;
---

<section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:px-8 lg:pt-24">
  <div>
    <p class="pill inline-flex rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.22em]">
      {t.hero.eyebrow}
    </p>

    <h1 class="mt-6 max-w-3xl text-4xl font-black leading-tight text-white sm:text-6xl">
      Beley Gómez <span class="text-gradient">Urdaneta</span>
    </h1>

    <p class="mt-4 text-xl font-semibold text-cyan-200">
      {site.role[t.lang]}
    </p>

    <p class="mt-5 max-w-2xl text-2xl font-bold text-white">
      {t.hero.title}
    </p>

    <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
      {t.hero.description}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#project" class="btn-primary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5">
        {t.hero.primaryCta}
      </a>
      <a href={whatsappUrl} target="_blank" rel="noreferrer" class="btn-secondary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-cyan-300/40">
        {t.hero.secondaryCta}
      </a>
      <a href={site.cv} target="_blank" rel="noreferrer" class="btn-secondary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-violet-300/40">
        {t.hero.cvCta}
      </a>
    </div>
  </div>

  <div class="glass relative overflow-hidden rounded-[2rem] p-6">
    <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute -bottom-16 -left-16 h-40 w-40 rounded-full bg-violet-400/20 blur-3xl"></div>

    <div class="relative">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Portfolio</p>
      <div class="mt-6 grid gap-4">
        {t.hero.highlights.map((item, index) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-cyan-400/15 text-sm font-black text-cyan-200">
                0{index + 1}
              </span>
              <p class="pt-2 text-sm font-medium leading-7 text-slate-200">{item}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
