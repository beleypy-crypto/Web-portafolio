---
import type { Dictionary } from '../i18n/es';
import { site } from '../data/site';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t.contact.defaultMessage)}`;
const demoUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t.contact.demoMessage)}`;
---

<section class="relative mx-auto grid max-w-6xl gap-12 px-4 pb-24 pt-16 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:px-8 lg:pt-24">
  <div class="aurora left-[-8rem] top-[-8rem] h-72 w-72 bg-cyan-400/25"></div>
  <div class="aurora right-[-10rem] top-24 h-80 w-80 bg-violet-500/25" style="animation-delay: -3s;"></div>
  <div class="aurora bottom-[-10rem] right-10 h-72 w-72 bg-[#ff2d3f]/20" style="animation-delay: -1.5s;"></div>

  <div class="relative">
    <div class="flex flex-wrap items-center gap-3">
      <p class="pill inline-flex rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.22em]">
        {t.hero.eyebrow}
      </p>
      <p class="inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-400/10 px-4 py-2 text-xs font-semibold text-emerald-200">
        <span class="status-dot animate-soft-pulse"></span>
        {t.hero.badge}
      </p>
    </div>

    <h1 class="mt-6 max-w-3xl text-4xl font-black leading-tight text-white sm:text-6xl">
      Beley Gómez <span class="text-gradient">Urdaneta</span>
    </h1>

    <p class="mt-4 text-xl font-semibold text-cyan-200">
      {site.role[t.lang]}
    </p>

    <p class="mt-5 max-w-2xl text-2xl font-bold leading-tight text-white">
      {t.hero.title}
    </p>

    <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
      {t.hero.description}
    </p>

    <p class="mt-5 text-sm font-medium uppercase tracking-[0.2em] text-slate-500">
      {t.hero.location}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#project" class="btn-primary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5">
        {t.hero.primaryCta}
      </a>
      <a href={whatsappUrl} target="_blank" rel="noreferrer" class="btn-secondary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-cyan-300/40">
        {t.hero.secondaryCta}
      </a>
      <a href={demoUrl} target="_blank" rel="noreferrer" class="btn-secondary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-emerald-300/40">
        {t.hero.demoCta}
      </a>
      <a href={site.cv} target="_blank" rel="noreferrer" class="btn-secondary rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-violet-300/40">
        {t.hero.cvCta}
      </a>
    </div>

    <div class="mt-9 grid max-w-xl gap-3 sm:grid-cols-3">
      {t.hero.highlights.map((item, index) => (
        <div class="card-hover rounded-2xl border border-white/10 bg-white/[0.035] p-4">
          <p class="text-sm font-black text-cyan-200">0{index + 1}</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">{item}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
    <div class="absolute -left-8 top-10 h-40 w-40 rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute -bottom-8 -right-8 h-48 w-48 rounded-full bg-[#ff2d3f]/24 blur-3xl"></div>

    <figure class="glass animate-float relative overflow-hidden rounded-[2.25rem] p-3">
      <div class="relative overflow-hidden rounded-[1.8rem] border border-white/10 bg-slate-950">
        <img
          src="/assets/profile/profile.png"
          alt={t.hero.photoAlt}
          class="aspect-[4/5] h-full w-full object-cover"
          loading="eager"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050816]/88 via-transparent to-transparent"></div>

        <figcaption class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200">Portfolio</p>
              <p class="mt-2 text-2xl font-black text-white">Beley Gómez</p>
              <p class="mt-1 text-sm text-slate-300">{site.role[t.lang]}</p>
            </div>
            <span class="pill rounded-full px-3 py-1 text-xs font-semibold">Python · IA</span>
          </div>
        </figcaption>
      </div>

      <div class="flex items-center justify-between px-2 pt-4 text-xs text-slate-400">
        <span>{t.hero.location}</span>
        <span class="text-gradient font-bold">IA + Backend</span>
      </div>
    </figure>
  </div>
</section>
