---
import type { Dictionary } from '../i18n/es';
import SectionHeader from './SectionHeader.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="project" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeader eyebrow={t.project.eyebrow} title={t.project.title} subtitle={t.project.subtitle} />

  <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <article class="glass rounded-[2rem] p-6 sm:p-8">
      <div class="grid gap-5">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-300">{t.project.problemLabel}</h3>
          <p class="mt-3 leading-8 text-slate-300">{t.project.problem}</p>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-[0.22em] text-violet-300">{t.project.solutionLabel}</h3>
          <p class="mt-3 leading-8 text-slate-300">{t.project.solution}</p>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-[0.22em] text-slate-100">{t.project.impactLabel}</h3>
          <p class="mt-3 leading-8 text-slate-300">{t.project.impact}</p>
        </div>
      </div>
    </article>

    <article class="glass rounded-[2rem] p-6 sm:p-8">
      <h3 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-300">{t.project.flowTitle}</h3>
      <ol class="mt-6 grid gap-4">
        {t.project.flow.map((step, index) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-400/15 text-sm font-black text-violet-200">
              {index + 1}
            </span>
            <p class="pt-1.5 text-sm leading-7 text-slate-300">{step}</p>
          </li>
        ))}
      </ol>

      <h3 class="mt-8 text-sm font-bold uppercase tracking-[0.22em] text-cyan-300">{t.project.stackTitle}</h3>
      <div class="mt-4 flex flex-wrap gap-2">
        {t.project.stack.map((tech) => (
          <span class="pill rounded-full px-4 py-2 text-xs font-semibold">{tech}</span>
        ))}
      </div>
    </article>
  </div>
</section>
