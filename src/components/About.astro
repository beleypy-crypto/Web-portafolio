---
import type { Dictionary } from '../i18n/es';
import SectionHeader from './SectionHeader.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeader eyebrow={t.about.eyebrow} title={t.about.title} subtitle={t.about.description} />

  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    <article class="glass rounded-[2rem] p-6 sm:p-8">
      <h3 class="text-lg font-black text-white">{t.about.educationTitle}</h3>
      <ul class="mt-6 grid gap-4">
        {t.about.education.map((item) => (
          <li class="flex gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-sm leading-7 text-slate-300">
            <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-cyan-300"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="glass rounded-[2rem] p-6 sm:p-8">
      <h3 class="text-lg font-black text-white">{t.about.languagesTitle}</h3>
      <div class="mt-6 grid gap-4">
        {t.about.languages.map((language) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-sm font-medium text-slate-300">
            {language}
          </div>
        ))}
      </div>
    </article>
  </div>
</section>
