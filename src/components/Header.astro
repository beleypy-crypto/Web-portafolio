---
import type { Dictionary } from '../i18n/es';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const items = [
  { href: '#about', label: t.nav.about },
  { href: '#project', label: t.nav.project },
  { href: '#services', label: t.nav.services },
  { href: '#skills', label: t.nav.skills },
  { href: '#certificates', label: t.nav.certificates },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#050816]/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={`/${t.lang}/`} class="text-sm font-semibold tracking-[0.22em] uppercase text-white">
      Beley <span class="text-gradient">Gómez</span>
    </a>

    <nav class="flex flex-wrap items-center gap-4 text-sm text-slate-300">
      {items.map((item) => (
        <a class="transition hover:text-cyan-300" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <LanguagePicker lang={t.lang} />
  </div>
</header>
