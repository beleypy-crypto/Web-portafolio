---
import type { Dictionary } from '../i18n/es';
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t.contact.defaultMessage)}`;
const demoUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t.contact.demoMessage)}`;
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeader eyebrow={t.contact.eyebrow} title={t.contact.title} subtitle={t.contact.subtitle} />

  <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <aside class="glass rounded-[2rem] p-6 sm:p-8">
      <h3 class="text-lg font-black text-white">{t.contact.whatsappTitle}</h3>
      <p class="mt-4 leading-8 text-slate-300">{t.contact.whatsappText}</p>

      <div class="mt-6 grid gap-3 text-sm text-slate-300">
        <p>
          <span class="font-semibold text-slate-100">{t.contact.phoneLabel}:</span> {site.phoneDisplay}
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        class="btn-primary mt-8 inline-flex rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5"
      >
        {t.contact.whatsappCta}
      </a>

      <a
        href={demoUrl}
        target="_blank"
        rel="noreferrer"
        class="btn-secondary mt-4 inline-flex rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5 hover:border-emerald-300/40"
      >
        {t.hero.demoCta}
      </a>

      <p class="mt-6 text-sm leading-7 text-slate-400">{t.contact.note}</p>
      <a href={site.cv} target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-semibold text-cyan-300 transition hover:text-cyan-200">
        {t.hero.cvCta}
      </a>
    </aside>

    <form id="contact-form" class="glass rounded-[2rem] p-6 sm:p-8">
      <h3 class="text-lg font-black text-white">{t.contact.formTitle}</h3>
      <p class="mt-3 text-sm leading-7 text-slate-300">{t.contact.formSubtitle}</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-semibold text-slate-200">
          {t.contact.name}
          <input
            required
            name="name"
            type="text"
            class="rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300/60"
          />
        </label>

        <label class="grid gap-2 text-sm font-semibold text-slate-200">
          {t.contact.email}
          <input
            name="email"
            type="email"
            class="rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300/60"
          />
        </label>
      </div>

      <label class="mt-4 grid gap-2 text-sm font-semibold text-slate-200">
        {t.contact.topic}
        <select
          name="topic"
          class="rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white outline-none transition focus:border-cyan-300/60"
        >
          {t.contact.topics.map((topic) => <option value={topic}>{topic}</option>)}
        </select>
      </label>

      <label class="mt-4 grid gap-2 text-sm font-semibold text-slate-200">
        {t.contact.message}
        <textarea
          required
          name="message"
          rows="5"
          class="rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300/60"
        ></textarea>
      </label>

      <button type="submit" class="btn-primary mt-6 w-full rounded-2xl px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5">
        {t.contact.submit}
      </button>
    </form>
  </div>
</section>

<script
  is:inline
  define:vars={{
    phone: site.whatsappNumber,
    labels: {
      name: t.contact.name,
      email: t.contact.email,
      topic: t.contact.topic,
    },
  }}
>
  const form = document.querySelector('#contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const formData = new FormData(event.currentTarget);
    const name = String(formData.get('name') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const topic = String(formData.get('topic') || '').trim();
    const message = String(formData.get('message') || '').trim();

    const lines = [
      name && `${labels.name}: ${name}`,
      email && `${labels.email}: ${email}`,
      topic && `${labels.topic}: ${topic}`,
      '',
      message,
    ].filter(Boolean);

    const url = `https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
