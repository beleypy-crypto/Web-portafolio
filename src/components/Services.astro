---
import type { Dictionary } from '../i18n/es';
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="services" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeader eyebrow={t.services.eyebrow} title={t.services.title} subtitle={t.services.subtitle} />

  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    {t.services.items.map((service) => {
      const url = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`${t.services.messagePrefix}${service.title}`)}`;

      return (
        <article class="glass card-hover flex h-full flex-col rounded-[2rem] p-6 sm:p-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400/20 to-violet-400/20">
            <svg viewBox="0 0 24 24" class="h-6 w-6 text-cyan-200" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v3" />
              <path d="M12 18v3" />
              <path d="M3 12h3" />
              <path d="M18 12h3" />
              <path d="m5.6 5.6 2.1 2.1" />
              <path d="m16.3 16.3 2.1 2.1" />
              <path d="m18.4 5.6-2.1 2.1" />
              <path d="m7.7 16.3-2.1 2.1" />
              <circle cx="12" cy="12" r="3.2" />
            </svg>
          </div>

          <h3 class="mt-6 text-xl font-black text-white">{service.title}</h3>
          <p class="mt-3 flex-1 leading-8 text-slate-300">{service.description}</p>

          <ul class="mt-6 grid gap-3 text-sm text-slate-300">
            {service.bullets.map((bullet) => (
              <li class="flex items-center gap-3">
                <span class="h-2 w-2 rounded-full bg-cyan-300"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>

          <a href={url} target="_blank" rel="noreferrer" class="btn-secondary mt-7 rounded-2xl px-5 py-3 text-center text-sm font-bold transition hover:-translate-y-0.5 hover:border-cyan-300/40">
            {t.services.cta}
          </a>
        </article>
      );
    })}
  </div>

  <div class="glass mt-8 rounded-[2rem] p-6 sm:p-8">
    <h3 class="text-lg font-black text-white">{t.services.processTitle}</h3>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {t.services.process.map((step, index) => (
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-sm font-black text-cyan-200">0{index + 1}</p>
          <p class="mt-2 text-sm leading-7 text-slate-300">{step}</p>
        </div>
      ))}
    </div>
  </div>
</section>
