---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
}

const { title, description, lang } = Astro.props;
const siteName = 'Beley Gómez Urdaneta';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/assets/og.svg', Astro.site).toString();
const esUrl = new URL('/es/', Astro.site).toString();
const enUrl = new URL('/en/', Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Beley Gómez Urdaneta',
  url: canonicalUrl,
  image: ogImage,
  jobTitle: lang === 'es' ? 'Desarrollador de IA, Automatización y Backend' : 'AI, Automation and Backend Developer',
  knowsAbout: ['Python', 'FastAPI', 'LangGraph', 'LangChain', 'Automation', 'AI agents'],
  sameAs: ['https://github.com/beleypy-crypto'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050816" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
